def run_iters(saraswati_state):
    while(saraswati_state.arrivals_count != len(saraswati_state.applications)):
        #Stall until all of the clients are waiting
        time.sleep(1)
    for pid in saraswati_state.applications:
        pid_client_lock = saraswati_state.application_client_locks[pid] #Grab lock for application
        saraswati_state.started_iter() #Started iteration
        if(not(saraswati_state.is_shutdown())):
            if saraswati_state.run_again[pid]:
                with pid_client_lock:
                    print(f"NOTIFYING {pid}:{saraswati_state.applications[pid]}")
                    pid_client_lock.notify()
                while(saraswati_state.is_running()):
                    time.sleep(1) #put a wait?
                saraswati_state.iter_count[pid] += 1
        else:
            with pid_client_lock:
                print(f"(SHUTDOWN) NOTIFYING {pid}:{saraswati_state.applications[pid]}")
                pid_client_lock.notify()
            while(saraswati_state.is_running()):
                time.sleep(1)            
        
def shutdown(saraswati_state):
    print("SHUTTING DOWN APPS")
    while(saraswati_state.arrivals_count != len(saraswati_state.applications)):
        #Stall until all of the clients are waiting
        time.sleep(1)
    saraswati_state.shutdown() #Set the shutdown flag
    #Wake up threads to shutdown
    run_iters(saraswati_state)

def spearman_err(saraswati_state):
    n = len(saraswati_state.df_train.columns) - 4 #4 is for power, iteration, benchmark, ts
    r = saraswati_state.target_corr
    if n <= 2:
        return -100
    return sqrt((1-r**2)/(n-2))

def check_loop(saraswati_state):
    ratios = None    
    dynamic_original_training(saraswati_state)
    ratios = saraswati_state.ratios
    for pid in saraswati_state.run_again:
        b = saraswati_state.applications[pid]
        checking_accuracy = (not(saraswati_state.super_iteration) and saraswati_state.iter_count[pid] <= 50) or (saraswati_state.super_iteration and saraswati_state.iter_count[pid] <= 500)
        target_accuracy_missed = (saraswati_state.corrs == [] or saraswati_state.corrs[-1]+spearman_err(saraswati_state) <= saraswati_state.target_corr or saraswati_state.ratios[-1] > .105)
        checking_stability = not(checking_accuracy)
        #target_stability_missed = np.array(saraswati_state.corrs[-10:]).std() > .05
        target_stability_missed = (abs(saraswati_state.ratios[-1] - saraswati_state.ratios[-2]) > .05) if len(saraswati_state.ratios) > 1 else True
        if saraswati_state.corrs != []:
            print(f"corr + err: {saraswati_state.corrs[-1]+spearman_err(saraswati_state)}")
            saraswati_state.corrs_err.append(spearman_err(saraswati_state))
        if (checking_accuracy and target_accuracy_missed) or (checking_stability and target_stability_missed): #or (saraswati_state.iter_count[pid] < 1000): #Added last check for corr/ratio graphs---should remove after
            saraswati_state.run_again[pid] = True
        else:
            saraswati_state.run_again[pid] = False
    return any([saraswati_state.run_again[k] for k in saraswati_state.run_again])

def align(saraswati_state):
    for pid in saraswati_state.run_again:
        if saraswati_state.run_again[pid]:
            try:
                if saraswati_state.super_iteration:
                    align_df_power = align_benchmark_iter_power_super(saraswati_state.output_directory, saraswati_state.applications[pid], saraswati_state.iter_count[pid]-49, saraswati_state.iter_count[pid], warm_up=0, bucket=BUCKET_SIZE_MS)
                    if not(saraswati_state.baseline):
                        profiles_cnt = align_benchmark_iter_profiler_super(saraswati_state.output_directory, saraswati_state.applications[pid], saraswati_state.iter_count[pid]-49, saraswati_state.iter_count[pid], warm_up=0, bucket=BUCKET_SIZE_MS)
                else:
                #If we an an iteration we must align that data and store it in memory, i.e. append it to our df
                    align_df_power = align_benchmark_iter_power(saraswati_state.output_directory, saraswati_state.applications[pid], saraswati_state.iter_count[pid], warm_up=0, bucket=BUCKET_SIZE_MS)
                    if not(saraswati_state.baseline):
                        profiles_cnt = align_benchmark_iter_profiler(saraswati_state.output_directory, saraswati_state.applications[pid], saraswati_state.iter_count[pid], warm_up=0, bucket=BUCKET_SIZE_MS)
                #Join the two alignment frames
                #print(profiles_cnt)
                align_df_power = get_clean_saraswati_df(saraswati_state, align_df_power)
                if saraswati_state.baseline:
                    saraswati_state.aligned_data = pd.concat([saraswati_state.aligned_data, align_df_power])
                    return
                b = saraswati_state.applications[pid]
                p_c_b = profiles_cnt[profiles_cnt.benchmark == b].dropna(axis=1, how="all").fillna(-1)
                align_df = align_df_power[["benchmark", "ts","power", "iteration"]].fillna(-1).merge(p_c_b, on=["ts","benchmark"])
                #align_df = align_df.rename(lambda method : method.replace("$", r"\$").replace("[", "").replace("]", "").replace("<", ""), axis=1)
                #saraswati_state.aligned_data = pd.concat([saraswati_state.aligned_data, align_df.reset_index()])
                #print(align_df)
                saraswati_state.aligned_data = pd.concat([saraswati_state.aligned_data, align_df])
            except Exception as e:
                #Suppress the exception for now
                print(f"{e}: Could not align most recent run!")
                return

def baseline_loop(saraswati_state):
    while saraswati_state.arrivals_count < 1: #Wait until the connection is made
        time.sleep(1)
    #Running a baseline, so no adaptive model building needed
    iters_to_run = 500 if saraswati_state.super_iteration else 50
    for i in range(iters_to_run):
        run_iters(saraswati_state)
        align(saraswati_state)
    shutdown(saraswati_state)
            
def saraswati_loop(saraswati_state):
    while saraswati_state.arrivals_count < 1: #Wait until the connection is made
        time.sleep(1)
    #Each app should be run at least 100 times
    for i in range(100):
        run_iters(saraswati_state)
        align(saraswati_state)
    while check_loop(saraswati_state):
        for i in range(10): #"A" variable in algo spec
            run_iters(saraswati_state)
            align(saraswati_state)
    shutdown(saraswati_state)

def saraswati_loop_super(saraswati_state):
    while saraswati_state.arrivals_count < 1: #Wait until the connection is made
        time.sleep(1)
    #Each app should be run at least five times
    for i in range(100):
        run_iters(saraswati_state)
    align(saraswati_state)
    while check_loop(saraswati_state):
        for i in range(50): #super iterations run 50 times before alignment 
            run_iters(saraswati_state)
        align(saraswati_state)
    shutdown(saraswati_state)

    
def parse_args():
    parser = argparse.ArgumentParser(description='saraswati server')
    parser.add_argument(
        '-t',
        '--transfer',
        default=False,
        action="store_true",
        help="Flag for performing transfer (default is dynamic original training)"
    )
    parser.add_argument(
        '--target',
        default=None,
        type=str,
        help="path to target data"
    )
    parser.add_argument(
        '--probes',
        default='monitor__wait',
        type=str,
        help='jvm probes to trace'
    )
    parser.add_argument(
        '--output_directory',
        default='.',
        type=str,
        help='top level directory containing experiment folders'
    )
    parser.add_argument(
        '-s',
        '--super_iteration',
        default=False,
        action="store_true",
        help="Flag for enabling super iterations (default is off)"
    )
    parser.add_argument(
        '-b',
        '--baseline',
        default=False,
        action="store_true",
        help="Flag for disabling profiler for getting baseline energy (default is off)"
    )
    return parser.parse_args()

    
def main():
    args = parse_args()
    state = SaraswatiState(args.probes, args.output_directory, args.target, args.transfer, args.super_iteration, args.baseline)
    server = grpc.server(futures.ThreadPoolExecutor()) #Not setting max_workers
    saraswati_service_pb2_grpc.add_SaraswatiServiceServicer_to_server(
        SaraswatiServiceServicer(state), server
    )
    server.add_insecure_port("[::]:50051")
    server.start()
    print("Started up Saraswati server")
    if state.baseline:
        baseline_loop(state)
    else:
        if not(state.super_iteration):
            saraswati_loop(state)
        else:
            saraswati_loop_super(state)
    print("ALL APPS DISCONNECTED")
    if not(state.baseline):
        dump(state)
    server.stop(5)    

if __name__ == "__main__":
    main()

